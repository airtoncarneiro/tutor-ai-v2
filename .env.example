# PostgreSQL bootstrap (used by docker-compose.yml on the first volume init)
TUTOR_POSTGRES_DB=tutor
TUTOR_POSTGRES_OWNER_USER=tutor_owner
TUTOR_POSTGRES_OWNER_PASSWORD=change-me-owner
TUTOR_POSTGRES_PORT=5432

# Restricted roles created by docker/postgres/init/01-bootstrap-roles.sh
TUTOR_APP_PASSWORD=change-me-app
TUTOR_RUNNER_PASSWORD=change-me-runner
TUTOR_EVALUATOR_PASSWORD=change-me-evaluator

# Application connection URLs. URL-encode special characters in passwords.
DATABASE_ADMIN_URL=postgresql://tutor_owner:change-me-owner@127.0.0.1:5432/tutor
DATABASE_APP_URL=postgresql://tutor_app:change-me-app@127.0.0.1:5432/tutor
DATABASE_RUNNER_URL=postgresql://tutor_runner:change-me-runner@127.0.0.1:5432/tutor
DATABASE_EVALUATOR_URL=postgresql://tutor_evaluator:change-me-evaluator@127.0.0.1:5432/tutor

# LLM adapter (optional for deterministic/local tests)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

LLM_TIMEOUT_SECONDS=30
SQL_TIMEOUT_MS=3000
SQL_LOCK_TIMEOUT_MS=1000
SQL_MAX_CHARS=20000
DISPLAY_ROW_LIMIT=200
EVALUATION_ROW_LIMIT=2000
RESULT_BYTE_LIMIT=2097152
STREAMLIT_SERVER_ADDRESS=127.0.0.1

