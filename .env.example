# PostgreSQL bootstrap (used by docker-compose.yml on the first volume init)
SQL_MENTOR_POSTGRES_DB=sql_mentor
SQL_MENTOR_POSTGRES_USER=mentor_admin
SQL_MENTOR_POSTGRES_PASSWORD=mentor_owner
SQL_MENTOR_POSTGRES_PORT=5432

# Restricted roles created by docker/postgres/init/01-bootstrap-roles.sh
SQL_MENTOR_APP_PASSWORD=mentor_app
SQL_MENTOR_SANDBOX_PASSWORD=mentor_runner
SQL_MENTOR_EVALUATOR_PASSWORD=mentor_evaluator

# Compatibility names accepted by the bootstrap script for older .env files.
TUTOR_POSTGRES_DB=${SQL_MENTOR_POSTGRES_DB}
TUTOR_POSTGRES_OWNER_USER=${SQL_MENTOR_POSTGRES_USER}
TUTOR_POSTGRES_OWNER_PASSWORD=${SQL_MENTOR_POSTGRES_PASSWORD}
TUTOR_POSTGRES_PORT=${SQL_MENTOR_POSTGRES_PORT}
TUTOR_APP_PASSWORD=${SQL_MENTOR_APP_PASSWORD}
TUTOR_RUNNER_PASSWORD=${SQL_MENTOR_SANDBOX_PASSWORD}
TUTOR_EVALUATOR_PASSWORD=${SQL_MENTOR_EVALUATOR_PASSWORD}

# Application connection URLs. URL-encode special characters in passwords.
DATABASE_ADMIN_URL=postgresql://${SQL_MENTOR_POSTGRES_USER}:${SQL_MENTOR_POSTGRES_PASSWORD}@127.0.0.1:${SQL_MENTOR_POSTGRES_PORT}/${SQL_MENTOR_POSTGRES_DB}
DATABASE_APP_URL=postgresql://tutor_app:${SQL_MENTOR_APP_PASSWORD}@127.0.0.1:${SQL_MENTOR_POSTGRES_PORT}/${SQL_MENTOR_POSTGRES_DB}
DATABASE_RUNNER_URL=postgresql://tutor_runner:${SQL_MENTOR_SANDBOX_PASSWORD}@127.0.0.1:${SQL_MENTOR_POSTGRES_PORT}/${SQL_MENTOR_POSTGRES_DB}
DATABASE_EVALUATOR_URL=postgresql://tutor_evaluator:${SQL_MENTOR_EVALUATOR_PASSWORD}@127.0.0.1:${SQL_MENTOR_POSTGRES_PORT}/${SQL_MENTOR_POSTGRES_DB}

# LLM adapter (optional for deterministic/local tests)
LLM_BASE_URL=
# The configured model must support Structured Outputs.
LLM_MODEL=
LLM_API_KEY=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
LLM_MAX_OUTPUT_TOKENS=2500
LLM_REASONING_ENABLED=false
SQL_TIMEOUT_MS=3000
SQL_LOCK_TIMEOUT_MS=1000
SQL_MAX_CHARS=20000
DISPLAY_ROW_LIMIT=200
EVALUATION_ROW_LIMIT=2000
RESULT_BYTE_LIMIT=2097152
STREAMLIT_SERVER_ADDRESS=127.0.0.1
